rules_version = '2';

// =========================================================
// STAGE SUPPORT — Reglas de Firestore
// Pega este contenido en Firebase Console → Firestore → Reglas
// =========================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function emailValido() {
      return request.auth != null
        && request.auth.token.email.matches('.*@stagesupport[.]com$');
    }

    function miPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function esAdmin() {
      return emailValido() && miPerfil().rol == 'Admin' && miPerfil().activo != false;
    }

    function estoyActivo() {
      return emailValido() && miPerfil().activo != false;
    }

    // ---- Colección de usuarios / empleados ----
    match /usuarios/{uid} {
      // Cualquier empleado activo puede leer el listado (para el dashboard,
      // menús, avatares, etc.)
      allow read: if estoyActivo();

      // Solo Admin puede crear, editar o eliminar perfiles de usuario.
      allow create, update, delete: if esAdmin();
    }

    // ---- Documentos del calendario (contratos, propuestas, riders,
    //      bookings, promotor, hojas de ruta, eventos) ----
    match /documentos/{docId} {
      // Cualquier empleado activo puede ver el calendario y crear documentos.
      allow read, create: if estoyActivo();

      // Solo quien lo creó, o un Admin, puede editarlo o eliminarlo.
      allow update, delete: if estoyActivo()
        && (resource.data.creadoPorUid == request.auth.uid || esAdmin());
    }

    // ---- Roster de espectáculos ----
    match /roster/{id} {
      allow read, write: if estoyActivo();
    }

    // ---- Jurídico del Roster (contratos) — SOLO Admin, ni siquiera lectura
    //      para el resto de empleados. Vive aparte de /roster/ a propósito.
    match /rosterJuridico/{id} {
      allow read, write: if esAdmin();
    }

    // ---- Propuestas a clientes (con ID correlativo PROV<año>-0001) ----
    match /propuestas/{id} {
      allow read, write: if estoyActivo();
    }

    // ---- Clientes ----
    match /clientes/{id} {
      allow read, write: if estoyActivo();
    }

    // ---- Venues (salas, festivales, recintos) ----
    match /venues/{id} {
      allow read, write: if estoyActivo();
    }

    // ---- Notificaciones entre cuentas ----
    match /notificaciones/{id} {
      // Solo el destinatario puede leerlas, marcarlas como leídas o borrarlas.
      allow read, update, delete: if estoyActivo() && resource.data.paraUid == request.auth.uid;
      // Cualquier activo puede crear una notificación... para otra persona.
      allow create: if estoyActivo() && request.resource.data.deUid == request.auth.uid;
    }

    // ---- Agenda personal (con opción de compartir) ----
    match /agenda/{id} {
      allow read: if estoyActivo()
        && (resource.data.propietarioUid == request.auth.uid
            || request.auth.uid in resource.data.compartidoCon);
      allow create: if estoyActivo() && request.resource.data.propietarioUid == request.auth.uid;
      allow update, delete: if estoyActivo() && resource.data.propietarioUid == request.auth.uid;
    }

    // ---- Notas personales (con opción de compartir) ----
    match /notas/{id} {
      allow read: if estoyActivo()
        && (resource.data.propietarioUid == request.auth.uid
            || request.auth.uid in resource.data.compartidoCon);
      allow create: if estoyActivo() && request.resource.data.propietarioUid == request.auth.uid;
      allow update, delete: if estoyActivo() && resource.data.propietarioUid == request.auth.uid;
    }

    // ---- Bookings (con ID correlativo BO<año>-0001) ----
    match /bookings/{id} {
      allow read, create: if estoyActivo();
      allow update, delete: if estoyActivo()
        && (resource.data.creadoPorUid == request.auth.uid || esAdmin());
    }

    // ---- Producciones (con ID correlativo PRO<año>-0001) ----
    match /producciones/{id} {
      allow read, create: if estoyActivo();
      allow update, delete: if estoyActivo()
        && (resource.data.creadoPorUid == request.auth.uid || esAdmin());
    }

    // ---- Hojas de Ruta (con ID correlativo HR<año>-0001) ----
    match /hojasDeRuta/{id} {
      allow read, create: if estoyActivo();
      allow update, delete: if estoyActivo()
        && (resource.data.creadoPorUid == request.auth.uid || esAdmin());
    }

    // ---- Bolsa de personal externo (técnicos, PMs, tour managers...) ----
    match /personal/{id} {
      allow read, write: if estoyActivo();
    }

    // ---- Contador de IDs correlativos (PRO25-0001, HR25-0001...) ----
    match /contadores/{id} {
      allow read, write: if estoyActivo();
    }

    // ---- Roles y permisos ----
    match /roles/{id} {
      allow read: if estoyActivo();
      allow write: if esAdmin();
    }

    // ---- Comisiones estándar ----
    match /comisiones/{id} {
      allow read: if estoyActivo();
      allow write: if esAdmin();
    }

    // ---- Configuración de la empresa (datos fiscales, logo) ----
    match /configuracion/{docId} {
      // Cualquier empleado activo puede leerla (para pintar el logo, etc.)
      allow read: if estoyActivo();
      // Solo Admin puede modificarla.
      allow write: if esAdmin();
    }

    // A medida que se añadan colecciones (bookings, producciones, clientes...)
    // define aquí sus reglas, apoyándote en estoyActivo() / esAdmin()
    // y, si hace falta, en el propio campo "rol" del usuario.
  }
}
